{
  "redirects": [
    {
      "source": "/:rest((?!\\.well-known/).*)",
      "has": [{ "type": "host", "value": "agendacapoeiragem.com" }],
      "destination": "https://www.agendacapoeiragem.com/:rest",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/process-scheduled-notifications",
      "schedule": "* * * * *"
    }
  ]
}
